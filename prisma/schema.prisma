// This file is automatically generated by ZenStack CLI and should not be manually updated. //
//////////////////////////////////////////////////////////////////////////////////////////////

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReportStatus {
  Pending
  InProgress
  Resolved
}

enum ReportDocumentType {
  brngy
  dswd
  committee
  council
}

model User {
  id         String    @id() @default(uuid())
  email      String    @unique()
  password   String
  name       String
  birthday   DateTime  @db.Date()
  gender     String
  grade      Int
  section    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt()
  isVerified Boolean   @default(false)
  otp        String?
  avatar     String?
  reports    Report[]
  guardian   Guardian?
}

model Guardian {
  id           String   @id() @default(uuid())
  email        String   @unique()
  name         String
  phone        String
  relationship String
  address      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt()
  studentId    String   @unique()
  student      User     @relation(fields: [studentId], references: [id])
}

model Guidance {
  id        String   @id() @default(uuid())
  email     String   @unique()
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  reports   Report[]
}

model Report {
  id           String           @id() @default(cuid())
  studentId    String
  details      String
  actionsTaken String?
  feelings     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt()
  status       ReportStatus     @default(Pending)
  notes        String?
  guidanceId   String?
  evidences    ReportEvidence[]
  guidance     Guidance?        @relation(fields: [guidanceId], references: [id])
  student      User             @relation(fields: [studentId], references: [id])
  ai_flag      AiReport?
  documents    ReportDocument[]
}

model ReportEvidence {
  id       String @id() @default(uuid())
  reportId String
  url      String
  report   Report @relation(fields: [reportId], references: [id])
}

model AiReport {
  id                String   @id() @default(uuid())
  report_id         String   @unique()
  flaggedAt         DateTime @default(now())
  reason            String
  toxicity          Int
  insult            Boolean
  threat            Boolean
  profanity         Boolean
  bullying_category String
  sentiment         String
  urgency           String
  report            Report   @relation(fields: [report_id], references: [id])
}

model ReportDocument {
  id        String             @id() @default(uuid())
  report_id String
  url       String
  type      ReportDocumentType
  report    Report             @relation(fields: [report_id], references: [id])
}
