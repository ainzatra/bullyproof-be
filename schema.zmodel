/// A sample data source using local sqlite db.
datasource db {
    provider = 'postgresql'
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id          String   @id @default(uuid())
    email       String   @unique
    password    String
    name        String
    birthday    DateTime @db.Date
    gender      String
    grade       Int
    section     String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    reports     Report[]
    guardian  Guardian?
}

model Guardian {
    id          String   @id @default(uuid())
    email       String   @unique
    name        String
    phone       String
    relationship String
    address     String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    studentId   String   @unique
    
    student    User     @relation(fields: [studentId], references: [id])
}

model Guidance {
    id          String   @id @default(uuid())
    email       String   @unique
    name        String
    password    String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    reports    Report[]
}

model Report {
    id          String   @id @default(uuid())
    studentId   String
    incident_date DateTime @db.Date
    details String
    type       String
    offender String
    offender_identity String // known, anonymous
    actionsTaken String
    feelings String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    status String // pending, reviewed, resolved, unresolved
    notes String?
    guidanceId String?

    guidance   Guidance? @relation(fields: [guidanceId], references: [id])
    student     User     @relation(fields: [studentId], references: [id])
    ai_flag   AiReport?
}

model AiReport {
    id          String   @id @default(uuid())
    report_id   String   @unique
    flaggedAt   DateTime @default(now())
    reason      String
    toxicity Int
    insult Boolean
    threat Boolean
    profanity Boolean
    bullying_category String
    sentiment String
    urgency String

    report      Report   @relation(fields: [report_id], references: [id])
}